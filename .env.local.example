# Copy to .env.local (local) or set in Vercel Project → Settings → Environment Variables.

# ElevenLabs API key — https://elevenlabs.io/app/settings/api-keys (server-only)
ELEVENLABS_API_KEY=

# Signing secret shown when you create the Speech-to-Text webhook in
# ElevenLabs → Settings → Webhooks. The webhook URL must point to
# https://<your-domain>/api/webhook
ELEVENLABS_WEBHOOK_SECRET=

# Auto-added by Vercel when you connect a Blob store to the project.
# Only set manually for local dev (vercel env pull).
BLOB_READ_WRITE_TOKEN=

# Optional: if set, the daily /api/cleanup cron requires this bearer token.
# Vercel injects it automatically for cron requests when present.
CRON_SECRET=
